# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub.

# Chave secreta de TESTE (Stripe > Desenvolvedores > Chaves de API). Começa com sk_test_
STRIPE_SECRET_KEY=cole-sua-chave-aqui
# Segredo do webhook. Quem gera é o comando "stripe listen" (começa com whsec_)
STRIPE_WEBHOOK_SECRET=whsec_COLE_AQUI

# Endereço do site (muda quando você fizer deploy)
URL_BASE=http://localhost:3000

# Segredo da sessão: invente uma frase longa e só sua
SEGREDO=troque-por-uma-frase-longa-e-secreta

<%- include('partials/cabecalho') %>
<%
  const temProblema = itens.some((i) => i.quantidade > i.Livro.estoque);
%>

<section class="painel" aria-labelledby="titulo-pagina">
  <p class="bits" aria-hidden="true">01000011 01000001 01010010 01010010</p>
  <h1 id="titulo-pagina" class="titulo-pixel">Seu carrinho</h1>

  <% if (itens.length === 0) { %>
    <p>Seu carrinho está vazio.</p>
    <p><a class="botao botao-principal" href="/">Ver os livros</a></p>
  <% } else { %>
    <p>Itens no carrinho: <%= itensCarrinho %>. O estoque só é reservado quando você finaliza o pedido.</p>

    <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Livros no seu carrinho</caption>
      <thead>
        <tr>
          <th scope="col">Livro</th>
          <th scope="col">Preço de cada</th>
          <th scope="col">Quantidade</th>
          <th scope="col">Subtotal</th>
          <th scope="col">Remover</th>
        </tr>
      </thead>
      <tbody>
        <% itens.forEach((item) => { %>
          <tr>
            <th scope="row">
              <%= item.Livro.titulo %>
              <% if (item.quantidade > item.Livro.estoque) { %>
                <p class="erro-campo" id="problema-<%= item.LivroId %>"><span class="so-leitor">Atenção:</span>
                  <%= item.Livro.estoque === 0 ? 'Este livro esgotou.' : 'Só temos ' + item.Livro.estoque + (item.Livro.estoque === 1 ? ' unidade' : ' unidades') + ' em estoque.' %>
                  Ajuste a quantidade ou remova o livro.</p>
              <% } else { %>
                <p class="dica">Em estoque: <%= item.Livro.estoque %></p>
              <% } %>
            </th>
            <td><%= dinheiro(item.Livro.precoCentavos) %></td>
            <td>
              <form class="form-linha" data-auto action="/api/carrinho/atualizar/<%= item.LivroId %>" method="post">
                <label class="so-leitor" for="quantidade-<%= item.LivroId %>">Quantidade de <%= item.Livro.titulo %></label>
                <input id="quantidade-<%= item.LivroId %>" name="quantidade" type="number" inputmode="numeric"
                       min="1" max="<%= Math.max(item.Livro.estoque, 1) %>" value="<%= item.quantidade %>" required
                       <%- item.quantidade > item.Livro.estoque ? 'aria-invalid="true" aria-describedby="problema-' + item.LivroId + '"' : '' %>>
                <button class="botao botao-leve" type="submit" data-atualizar aria-label="Atualizar quantidade de <%= item.Livro.titulo %>">Atualizar</button>
              </form>
            </td>
            <td><%= dinheiro(item.Livro.precoCentavos * item.quantidade) %></td>
            <td>
              <form action="/api/carrinho/remover/<%= item.LivroId %>" method="post">
                <button class="botao botao-leve" type="submit" aria-label="Remover <%= item.Livro.titulo %> do carrinho">Remover</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <th scope="row" colspan="3">Total do carrinho</th>
          <td><%= dinheiro(total) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
    </div>

    <div class="acoes">
      <a class="botao botao-leve" href="/">Continuar as compras</a>
      <% if (temProblema) { %>
        <p class="erro-campo">Corrija os livros com problema de estoque para finalizar o pedido.</p>
      <% } else { %>
        <form action="/finalizar" method="get">
          <button class="botao botao-principal" type="submit">Finalizar pedido</button>
        </form>
      <% } %>
    </div>
  <% } %>
</section>

<%- include('partials/rodape') %>

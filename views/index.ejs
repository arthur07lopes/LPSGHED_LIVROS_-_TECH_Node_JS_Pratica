<%- include('partials/cabecalho') %>
<%
  const classeNivel = { 'Iniciante': 'iniciante', 'Intermediário': 'intermediario', 'Avançado': 'avancado' };
  const filtrando = busca !== '' || nivel !== '';
%>

<section class="hero" aria-labelledby="titulo-pagina">
  <p class="bits" aria-hidden="true">01001100 01001001 01010110 01010010 01001111 01010011</p>
  <h1 id="titulo-pagina" class="titulo-pixel">Livros de programação</h1>
  <p>Do primeiro &ldquo;Olá, mundo&rdquo; ao código profissional. Para todas as idades e todos os níveis.</p>
</section>

<div id="aviso-dinamico" class="aviso aviso-erro" role="alert" tabindex="-1" hidden>
  <p></p>
</div>

<section aria-labelledby="titulo-catalogo">
  <h2 id="titulo-catalogo" class="titulo-secao" <%- filtrando ? 'tabindex="-1" data-foco' : '' %>>
    Catálogo: <%= livros.length %> <%= livros.length === 1 ? 'livro encontrado' : 'livros encontrados' %>
    <% if (nivel) { %> no nível <%= nivel %><% } %>
    <% if (busca) { %> para &ldquo;<%= busca %>&rdquo;<% } %>
  </h2>

  <% if (livros.length === 0) { %>
    <p>Nenhum livro encontrado. Tente outra palavra ou veja <a href="/">todos os níveis</a>.</p>
  <% } else { %>
    <ul class="grade">
      <% livros.forEach((livro) => { %>
        <li class="cartao">
          <div class="capa">
            <img src="https://covers.openlibrary.org/b/isbn/<%= livro.isbn %>-M.jpg" alt=""
  width="180" height="270" loading="lazy">
          </div>
          <h3><%= livro.titulo %></h3>
          <p class="autor">por <%= livro.autor %></p>
          <p><span class="selo selo-<%= classeNivel[livro.nivel] %>">Nível: <%= livro.nivel %></span></p>
          <p class="descricao"><%= livro.descricao %></p>
          <p class="preco"><%= dinheiro(livro.precoCentavos) %></p>
          <% if (livro.estoque === 0) { %>
            <p class="estoque estoque-zero">Esgotado</p>
          <% } else { %>
            <p class="estoque" id="estoque-<%= livro.id %>"><%= livro.estoque <= 2 ? 'Últimas ' + livro.estoque + (livro.estoque === 1 ? ' unidade' : ' unidades') + ' em estoque' : 'Em estoque: ' + livro.estoque + ' unidades' %></p>
            <form class="form-livro" action="/api/carrinho/adicionar/<%= livro.id %>" method="post" data-titulo="<%= livro.titulo %>">
              <div class="campo-quantidade">
                <label for="quantidade-<%= livro.id %>">Quantidade</label>
                <input id="quantidade-<%= livro.id %>" name="quantidade" type="number" inputmode="numeric"
                       min="1" max="<%= livro.estoque %>" value="1" required
                       aria-label="Quantidade de <%= livro.titulo %>" aria-describedby="estoque-<%= livro.id %>">
              </div>
              <button class="botao botao-comprar" type="submit" formaction="/api/comprar/<%= livro.id %>" aria-label="Comprar o livro <%= livro.titulo %>">Comprar</button>
              <button class="botao botao-carrinho" type="submit" data-adicionar aria-label="Adicionar ao carrinho: <%= livro.titulo %>">Adicionar ao carrinho</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="painel" aria-labelledby="titulo-pedidos">
  <h2 id="titulo-pedidos" class="titulo-secao">Seus pedidos</h2>
  <% if (pedidos.length === 0) { %>
    <p>Você ainda não fez nenhum pedido.</p>
  <% } else { %>
    <div class="tabela-rolagem">
    <table class="tabela">
      <caption>Livros que você já comprou, do pedido mais novo para o mais antigo</caption>
      <thead>
        <tr>
          <th scope="col">Pedido</th>
          <th scope="col">Data</th>
          <th scope="col">Livro</th>
          <th scope="col">Quantidade</th>
          <th scope="col">Preço de cada</th>
          <th scope="col">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% pedidos.forEach((p) => { %>
          <% p.ItemPedidos.forEach((item) => { %>
            <tr>
              <td>Nº <%= p.id %></td>
              <td><%= new Date(p.createdAt).toLocaleDateString('pt-BR') %></td>
              <th scope="row"><%= item.Livro.titulo %></th>
              <td><%= item.quantidade %></td>
              <td><%= dinheiro(item.precoCentavos) %></td>
              <td><%= dinheiro(item.precoCentavos * item.quantidade) %></td>
            </tr>
          <% }) %>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <th scope="row" colspan="3">Total</th>
          <td><%= totalLivros %> <%= totalLivros === 1 ? 'livro' : 'livros' %></td>
          <td></td>
          <td><%= dinheiro(total) %></td>
        </tr>
      </tfoot>
    </table>
    </div>
  <% } %>
</section>

<dialog id="dialogo-carrinho" class="dialogo" aria-labelledby="titulo-dialogo-carrinho" aria-describedby="texto-dialogo-carrinho">
  <h2 id="titulo-dialogo-carrinho" tabindex="-1">Produto adicionado ao carrinho!</h2>
  <p id="texto-dialogo-carrinho"></p>
  <div class="dialogo-botoes">
    <button class="botao botao-leve" type="button" id="continuar-compras">Continuar as compras</button>
    <form action="/finalizar" method="get">
      <button class="botao botao-principal" type="submit">Finalizar pedido</button>
    </form>
  </div>
</dialog>

<%- include('partials/rodape') %>

<%- include('partials/cabecalho') %>

<section class="painel painel-form" aria-labelledby="titulo-pagina">
  <p class="bits" aria-hidden="true">01001110 01001111 01010110 01001111</p>
  <h1 id="titulo-pagina" class="titulo-pixel">Criar conta</h1>
  <p>Cadastre-se para comprar livros de programação. Todos os campos são obrigatórios.</p>

  <% if (erros.length > 0) { %>
    <div id="resumo-erros" class="aviso aviso-erro" role="alert" tabindex="-1" data-foco>
      <h2>Encontramos <%= erros.length %> <%= erros.length === 1 ? 'problema' : 'problemas' %> no formulário</h2>
      <ul>
        <% erros.forEach((e) => { %>
          <li><a href="#<%= e.campo %>"><%= e.texto %></a></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form class="formulario" action="/api/cadastro" method="post" novalidate>
    <%- include('partials/campo', { id: 'nome', rotulo: 'Nome completo', tipo: 'text',
         autocomplete: 'name', dica: '', valor: valores.nome || '', erros }) %>
    <%- include('partials/campo', { id: 'email', rotulo: 'E-mail', tipo: 'email',
         autocomplete: 'email', dica: 'Exemplo: nome@exemplo.com', valor: valores.email || '', erros }) %>
    <%- include('partials/campo', { id: 'senha', rotulo: 'Senha', tipo: 'password',
         autocomplete: 'new-password', dica: 'Use pelo menos 8 caracteres.', valor: '', erros }) %>
    <%- include('partials/campo', { id: 'confirmacao', rotulo: 'Confirme a senha', tipo: 'password',
         autocomplete: 'new-password', dica: 'Digite a mesma senha de novo.', valor: '', erros }) %>

    <button class="botao botao-principal" type="submit">Criar minha conta</button>
  </form>

  <p class="troca">Já tem conta? <a href="/login">Entre aqui</a>.</p>
</section>

<%- include('partials/rodape') %>

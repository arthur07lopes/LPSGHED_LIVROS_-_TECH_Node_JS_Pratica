<%
  // Uma lista de escolha (select) com rótulo e erro.
  // Recebe: id, rotulo, autocomplete, opcoes (lista de textos), valor, erros.
  const erroDaLista = erros.find((e) => e.campo === id);
%>
<div class="campo<%= erroDaLista ? ' campo-com-erro' : '' %>">
  <label for="<%= id %>"><%= rotulo %></label>
  <% if (erroDaLista) { %>
    <p class="erro-campo" id="erro-<%= id %>"><span class="so-leitor">Erro:</span> <%= erroDaLista.texto %></p>
  <% } %>
  <select id="<%= id %>" name="<%= id %>" autocomplete="<%= autocomplete %>" required
          <%- erroDaLista ? 'aria-describedby="erro-' + id + '" aria-invalid="true"' : '' %>>
    <option value="">Selecione</option>
    <% opcoes.forEach((o) => { %>
      <option value="<%= o %>"<%= o === valor ? ' selected' : '' %>><%= o %></option>
    <% }) %>
  </select>
</div>

<%
  // Um campo de formulário completo: rótulo, dica, erro e input.
  // Recebe: id, rotulo, tipo, autocomplete, dica, valor, erros.
  // Opcionais: opcional (true = não é obrigatório), modo (inputmode do teclado).
  const erroDoCampo = erros.find((e) => e.campo === id);
  const ligacoes = [];
  if (dica) ligacoes.push('dica-' + id);
  if (erroDoCampo) ligacoes.push('erro-' + id);
%>
<div class="campo<%= erroDoCampo ? ' campo-com-erro' : '' %>">
  <label for="<%= id %>"><%= rotulo %></label>
  <% if (dica) { %>
    <p class="dica" id="dica-<%= id %>"><%= dica %></p>
  <% } %>
  <% if (erroDoCampo) { %>
    <p class="erro-campo" id="erro-<%= id %>"><span class="so-leitor">Erro:</span> <%= erroDoCampo.texto %></p>
  <% } %>
  <div class="campo-controle">
    <input id="<%= id %>" name="<%= id %>" type="<%= tipo %>" autocomplete="<%= autocomplete %>"
           value="<%= valor %>" <%- locals.opcional ? '' : 'required' %>
           <%- locals.modo ? 'inputmode="' + locals.modo + '"' : '' %>
           <%- ligacoes.length ? 'aria-describedby="' + ligacoes.join(' ') + '"' : '' %>
           <%- erroDoCampo ? 'aria-invalid="true"' : '' %>>
    <% if (tipo === 'password') { %>
      <button class="botao-olho" type="button" aria-label="Mostrar senha" aria-controls="<%= id %>">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 16" shape-rendering="crispEdges">
          <path fill="currentColor" d="M6 1h12v2h3v3h2v4h-2v3h-3v2H6v-2H3v-3H1V6h2V3h3z"/>
          <path fill="var(--superficie-2, #172033)" d="M6 4h12v2h2v4h-2v2H6v-2H4V6h2z"/>
          <path class="olho-pupila" fill="currentColor" d="M9 5h6v2h2v4h-2v2H9v-2H7V7h2z"/>
          <path class="olho-fechado" fill="currentColor" d="M4 8h16v2H4z"/>
        </svg>
      </button>
    <% } %>
  </div>
</div>
